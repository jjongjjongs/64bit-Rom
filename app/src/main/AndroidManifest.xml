<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 가상롬을 화면 밖에서도 살려 두는 VmService 용. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:theme="@style/AppTheme"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:roundIcon="@drawable/ic_launcher_round">
        <activity
            android:name="com.example.singlevm.GuestRunActivity"
            android:exported="true"
            android:process=":vm"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"/>
        <!-- 가상롬 본체. 실행 화면과 같은 ":vm" 프로세스여야 렌더러를 함께 쓴다. -->
        <service
            android:name="com.example.singlevm.VmService"
            android:exported="false"
            android:process=":vm"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's Android virtual machine running so games launch without a full reboot"/>
        </service>
        <activity
            android:name="com.example.singlevm.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 로그 파일을 통째로 공유하기 위한 통로. LogFileProvider 참고. -->
        <provider
            android:name="com.example.singlevm.LogFileProvider"
            android:authorities="com.example.singlevm.logs"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
